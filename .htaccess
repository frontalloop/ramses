# Cache policy for the static export (copied into out/ by `next build`).
#
# Next.js fingerprints every file under /_next/static/ with a content hash and
# deletes the previous build's files on redeploy. If the HTML document is cached
# longer than the chunks it points at, a visitor gets yesterday's HTML asking for
# chunks that no longer exist -> 404 -> ChunkLoadError. So: never cache the HTML,
# cache the hashed assets forever.

<IfModule mod_headers.c>
  # HTML entry points: always revalidate against the origin.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed build output: the filename changes whenever the content does.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
